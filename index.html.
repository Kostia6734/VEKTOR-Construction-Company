<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VEKTOR — Construction Company</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f1ec;--surface:#fff;--ink:#14161a;--muted:#5d626a;--line:rgba(20,22,26,.13);--accent:#e8590c;--hero:#101216;--heroink:#f2efe9;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1013;--surface:#16191e;--ink:#f2efe9;--muted:#9ba1a9;--line:rgba(255,255,255,.1);--accent:#ff7a2f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1013;--surface:#16191e;--ink:#f2efe9;--muted:#9ba1a9;--line:rgba(255,255,255,.1);--accent:#ff7a2f;color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--ink);font-family:Manrope,system-ui,Arial,sans-serif;line-height:1.55;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);font-weight:700;display:flex;align-items:center;gap:12px}
.eyebrow::before{content:"";width:36px;height:1px;background:currentColor}
h2{font-size:clamp(32px,4.6vw,60px);line-height:1.04;letter-spacing:-.025em;font-weight:800;margin:18px 0 0;max-width:15ch;text-wrap:balance}
/* curtain */
.curtain{position:fixed;inset:0;background:var(--hero);z-index:100;display:grid;place-items:center;color:var(--heroink);transition:transform 1s cubic-bezier(.77,0,.18,1) .5s}
.curtain b{font-size:22px;letter-spacing:.4em;font-weight:800;animation:pulse 1s ease infinite alternate}
body.ready .curtain{transform:translateY(-101%)}
@keyframes pulse{to{opacity:.35}}
.progress{position:fixed;left:0;top:0;height:3px;width:100%;background:var(--accent);transform-origin:left;transform:scaleX(0);z-index:60}
/* header */
header{position:fixed;left:0;right:0;top:0;z-index:50;padding-top:env(safe-area-inset-top,0px);transition:background .4s,border-color .4s;border-bottom:1px solid transparent;color:var(--heroink)}
header.solid{background:color-mix(in srgb,var(--hero) 88%,transparent);backdrop-filter:blur(14px);border-color:rgba(255,255,255,.08)}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:800;letter-spacing:.28em;font-size:17px;display:flex;align-items:center;gap:12px}
.logo i{width:26px;height:26px;background:var(--accent);clip-path:polygon(0 100%,0 30%,50% 0,100% 30%,100% 100%,60% 100%,60% 55%,40% 55%,40% 100%)}
.menu{display:flex;gap:34px;font-size:14px;font-weight:500}
.menu a{opacity:.75;transition:opacity .3s}.menu a:hover{opacity:1}
.btn{display:inline-flex;align-items:center;gap:12px;background:var(--accent);color:#fff;padding:15px 26px;font-weight:700;font-size:14px;letter-spacing:.02em;border:0;cursor:pointer;font-family:inherit;position:relative;overflow:hidden;transition:transform .3s}
.btn::after{content:"→";transition:transform .3s}.btn:hover::after{transform:translateX(6px)}.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;border:1px solid rgba(255,255,255,.3)}
.btn.ghost:hover{background:rgba(255,255,255,.08)}
/* hero */
.hero{min-height:100svh;background:var(--hero);color:var(--heroink);position:relative;overflow:hidden;display:flex;flex-direction:column;padding:100px 0 0}
.hero>.wrap{flex:1;align-content:center;padding-top:40px;padding-bottom:60px}
.grid-bg{position:absolute;inset:-10%;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse at 70% 50%,#000 20%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse at 70% 50%,#000 20%,transparent 75%)}
.glow{position:absolute;width:560px;height:560px;border-radius:50%;background:radial-gradient(closest-side,rgba(232,89,12,.35),transparent);right:6%;top:18%;filter:blur(30px);animation:float 9s ease-in-out infinite alternate}
@keyframes float{to{transform:translate(-40px,40px) scale(1.1)}}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;width:100%}
h1{font-size:clamp(36px,6vw,88px);line-height:.98;letter-spacing:-.035em;font-weight:800;margin:26px 0 28px}
.ln{display:block;overflow:hidden;padding-bottom:.08em}
.ln span{display:block;transform:translateY(110%);transition:transform 1.1s cubic-bezier(.16,1,.3,1)}
body.ready .ln span{transform:none}
.ln:nth-child(1) span{transition-delay:1.2s}.ln:nth-child(2) span{transition-delay:1.35s}
.ln em{font-style:normal;color:var(--accent);white-space:nowrap}
.lead{max-width:520px;font-size:18px;color:rgba(242,239,233,.72);font-weight:300}
.cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:38px}
.fade{opacity:0;transform:translateY(24px);transition:opacity 1s,transform 1s}
body.ready .fade{opacity:1;transform:none;transition-delay:1.7s}
.blueprint{width:100%;max-width:520px;justify-self:end}
.blueprint path,.blueprint line,.blueprint rect{fill:none;stroke:var(--heroink);stroke-width:1.4;stroke-dasharray:1200;stroke-dashoffset:1200;opacity:.8}
body.ready .blueprint *{animation:draw 3s ease forwards 1.4s}
.blueprint .acc{stroke:var(--accent);stroke-width:2.2}
@keyframes draw{to{stroke-dashoffset:0}}
.stats{position:relative;z-index:1;border-top:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.02)}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding-top:0;padding-bottom:0}
.stat{padding:22px 0 22px 24px;border-left:1px solid rgba(255,255,255,.1)}
.stat:first-child{border:0;padding-left:0}
.stat b{font-size:clamp(26px,3vw,40px);font-weight:800;display:block;line-height:1.1}
.stat>span{font-size:13px;color:rgba(242,239,233,.6)}
/* marquee */
.marq{background:var(--accent);color:#fff;overflow:hidden;white-space:nowrap;padding:16px 0;font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:14px}
.marq div{display:inline-block;animation:mq 30s linear infinite}
.marq span{margin:0 26px}
@keyframes mq{to{transform:translateX(-50%)}}
section{padding:130px 0}
/* advantages */
.adv{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:64px}
.card{background:var(--surface);padding:38px 30px 44px;position:relative;overflow:hidden;min-height:300px;transition:transform .5s}
.card::before{content:"";position:absolute;inset:0;background:radial-gradient(260px circle at var(--mx,50%) var(--my,0),color-mix(in srgb,var(--accent) 22%,transparent),transparent 70%);opacity:0;transition:opacity .4s}
.card:hover::before{opacity:1}
.card .n{font-size:13px;color:var(--muted);font-weight:700}
.card svg{width:44px;height:44px;margin:34px 0 26px;stroke:var(--accent);fill:none;stroke-width:1.6;position:relative}
.card h3{font-size:20px;line-height:1.2;margin-bottom:10px;position:relative}
.card p{color:var(--muted);font-size:15px;position:relative}
/* services */
.svc{margin-top:64px;border-top:1px solid var(--line)}
.row{display:grid;grid-template-columns:70px 1.1fr 1.4fr 40px;gap:30px;align-items:start;padding:38px 0;border-bottom:1px solid var(--line);position:relative;transition:padding .5s cubic-bezier(.16,1,.3,1)}
.row::before{content:"";position:absolute;left:0;bottom:-1px;height:2px;width:100%;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .7s cubic-bezier(.16,1,.3,1)}
.row:hover::before{transform:scaleX(1)}.row:hover{padding-left:18px}
.row .n{color:var(--accent);font-weight:700;font-size:14px;padding-top:10px}
.row h3{font-size:clamp(24px,2.6vw,34px);letter-spacing:-.02em;line-height:1.12}
.row p{color:var(--muted);max-width:52ch}
.row .tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.row .tags span{font-size:12px;border:1px solid var(--line);padding:5px 12px;border-radius:99px;color:var(--muted)}
.row .ar{font-size:26px;transition:transform .5s;color:var(--accent)}.row:hover .ar{transform:rotate(-45deg)}
/* process */
.dark{background:var(--hero);color:var(--heroink)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-top:70px;position:relative}
.steps::before{content:"";position:absolute;left:0;top:7px;height:1px;width:100%;background:rgba(255,255,255,.15)}
.steps::after{content:"";position:absolute;left:0;top:7px;height:1px;width:100%;background:var(--accent);transform:scaleX(var(--p,0));transform-origin:left}
.step i{display:block;width:15px;height:15px;background:var(--hero);border:2px solid var(--accent);border-radius:50%;position:relative;z-index:1;margin-bottom:30px}
.step b{font-size:13px;color:var(--accent);letter-spacing:.14em}
.step h3{font-size:22px;margin:8px 0 10px}.step p{color:rgba(242,239,233,.62);font-size:15px}
/* contact */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:stretch}
.contact p.l{color:var(--muted);font-size:18px;margin:24px 0 40px;max-width:44ch}
.info div{padding:18px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.info span{color:var(--muted);font-size:14px}.info div:last-child{border-bottom:1px solid var(--line)}.info b{font-weight:700}
form{background:var(--surface);border:1px solid var(--line);padding:42px;display:grid;gap:22px;align-content:space-between}
label{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700;display:block}
input,select{width:100%;margin-top:8px;padding:12px 0;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);font:inherit;font-size:17px;outline:0;transition:border-color .3s;border-radius:0}
input:focus,select:focus{border-color:var(--accent)}
select option{background:var(--surface);color:var(--ink)}
input::placeholder{color:var(--muted);opacity:.7}
.ok{display:none;color:var(--accent);font-weight:700}
footer{background:var(--hero);color:rgba(242,239,233,.55);padding:34px 0;font-size:13px}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.wipe{position:fixed;inset:0;background:var(--accent);z-index:90;transform:translateY(100%);pointer-events:none}
.blueprint{transition:transform .25s ease-out}
.burger{display:none;width:44px;height:44px;background:none;border:0;cursor:pointer;position:relative;color:inherit;flex:none}
.burger i{position:absolute;left:10px;right:10px;height:2px;background:currentColor;transition:transform .5s cubic-bezier(.77,0,.18,1),top .5s}
.burger i:nth-child(1){top:17px}.burger i:nth-child(2){top:25px}
body.mo .burger i:nth-child(1){top:21px;transform:rotate(45deg)}body.mo .burger i:nth-child(2){top:21px;transform:rotate(-45deg)}
body.mo{overflow:hidden}body.mo header{background:none;backdrop-filter:none;border-color:transparent}
.ov{position:fixed;inset:0;background:var(--hero);color:var(--heroink);z-index:45;display:flex;flex-direction:column;justify-content:center;padding:80px 28px 40px;clip-path:circle(0 at calc(100% - 40px) 40px);visibility:hidden;transition:clip-path .8s cubic-bezier(.77,0,.18,1),visibility 0s .8s}
body.mo .ov{clip-path:circle(150% at calc(100% - 40px) 40px);visibility:visible;transition:clip-path .8s cubic-bezier(.77,0,.18,1)}
.ov a{font-size:clamp(32px,9vw,56px);font-weight:800;letter-spacing:-.02em;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.1);opacity:0;transform:translateY(34px);transition:opacity .5s,transform .7s cubic-bezier(.16,1,.3,1)}
body.mo .ov a{opacity:1;transform:none;transition-delay:calc(.3s + var(--i)*.07s)}
.hs{padding:0}
.hs-pin{position:sticky;top:0;height:100vh;height:100svh;display:flex;flex-direction:column;justify-content:center;gap:40px;overflow:hidden}
.hs-pin>.wrap{width:100%}
.hs-track{display:flex;gap:24px;width:max-content;padding:0 max(28px,calc((100vw - 1184px)/2));will-change:transform}
.pj{flex:0 0 min(460px,80vw);height:min(48vh,410px);position:relative;overflow:hidden;color:#fff;padding:30px;display:flex;flex-direction:column;justify-content:space-between;background:var(--g)}
.pj::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.06) 0 1px,transparent 1px 48px);transition:transform .8s}
.pj::after{content:'';position:absolute;right:-12%;bottom:-8%;width:62%;height:68%;border:1px solid rgba(255,255,255,.35);background:linear-gradient(180deg,rgba(255,255,255,.12),transparent);transition:transform .9s cubic-bezier(.16,1,.3,1)}
.pj:hover::after{transform:translate(-16px,-16px) scale(1.06)}.pj:hover::before{transform:translateX(24px)}
.pj>*{position:relative;z-index:1}
.pj span{font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.75}
.pj h3{font-size:26px;line-height:1.15;letter-spacing:-.01em}.pj p{opacity:.75;font-size:14px;margin-top:6px}
@media (max-width:980px){.nav>.btn{margin-left:auto}.burger{display:block}.steps::before,.steps::after{display:none}.hs-pin{position:static;height:auto;padding:90px 0}.hs-track{width:auto;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-width:none}.hs-track::-webkit-scrollbar{display:none}.pj{scroll-snap-align:start;height:340px}}
@media (max-width:400px){.nav>.btn{display:none}.burger{margin-left:auto}}
/* reveal */
.rv{opacity:0;transform:translateY(46px);transition:opacity .9s,transform .9s cubic-bezier(.16,1,.3,1);transition-delay:var(--d,0s)}
.rv.in{opacity:1;transform:none}
h2.rv{transform:translateY(60px) skewY(3deg);filter:blur(10px);transition:opacity 1s,transform 1.1s cubic-bezier(.16,1,.3,1),filter 1s}
h2.rv.in{filter:none;transform:none}
@media (max-width:980px){
.menu{display:none}.hero .wrap{grid-template-columns:1fr}.blueprint{max-width:230px;justify-self:start;order:-1}
.hero{padding-top:90px}.adv,.steps{grid-template-columns:1fr 1fr}.contact{grid-template-columns:1fr;gap:50px}
.row{grid-template-columns:44px 1fr;gap:14px}.row>div{grid-column:2}.row .ar{display:none}.stats .wrap{grid-template-columns:1fr 1fr}.stat:nth-child(3){border:0;padding-left:0}
.stat{padding:12px 0 12px 18px}section{padding:90px 0}}
@media (max-width:560px){.adv,.steps{grid-template-columns:1fr}.wrap{padding:0 20px}form{padding:28px 22px}.nav .btn{padding:11px 16px}.blueprint{max-width:150px}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.ln span,.fade,.rv{transform:none;opacity:1}.blueprint *{stroke-dashoffset:0!important}.curtain{display:none}h2.rv{filter:none}.wipe{display:none}}
</style>
</head>
<body>
<div class="curtain"><b>VEKTOR</b></div>
<div class="progress" id="pg"></div><div class="wipe" id="wp"></div>
<header id="hd"><div class="wrap nav">
