function adv(){var y=scrollY;
if(wide.matches&&!rm){var r=hs.getBoundingClientRect(),m=hs.offsetHeight-innerHeight,p=Math.max(0,Math.min(1,-r.top/m));tk.style.transform='translateX('+(-p*(tk.scrollWidth-innerWidth))+'px)'}
if(!rm){mqe.style.animation='none';mqe.style.transform='translateX('+(-(y*.5)%(mqe.scrollWidth/2))+'px)';
if(y<innerHeight*1.2){hw.style.transform='translateY('+(y*.22)+'px)';hw.style.opacity=Math.max(0,1-y/(innerHeight*.85))}}}
addEventListener('scroll',adv,{passive:true});adv();
if(fine&&!rm){var hero=document.querySelector('.hero');
addEventListener('mousemove',function(e){
