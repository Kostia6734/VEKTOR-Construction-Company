document.getElementById('fm').addEventListener('submit',function(e){e.preventDefault();document.getElementById('ok').style.display='block';e.target.reset()});
var rm=matchMedia('(prefers-reduced-motion:reduce)').matches,fine=matchMedia('(pointer:fine)').matches,wide=matchMedia('(min-width:981px)');
var bg=document.getElementById('bg');
bg.addEventListener('click',function(){b.classList.toggle('mo');bg.setAttribute('aria-expanded',b.classList.contains('mo'))});
var wp=document.getElementById('wp');
document.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener('click',function(e){
var h=a.getAttribute('href'),t=document.querySelector(h);if(!t)return;e.preventDefault();
var go=function(){h==='#top'?scrollTo({top:0,behavior:'instant'}):t.scrollIntoView({behavior:'instant'})};
b.classList.remove('mo');
if(rm){go();return}
wp.style.transition='transform .55s cubic-bezier(.77,0,.18,1)';wp.style.transform='translateY(0)';
setTimeout(function(){go();wp.style.transform='translateY(-100%)';setTimeout(function(){wp.style.transition='none';wp.style.transform='translateY(100%)'},650)},600)})});
