<script>
(function(){
var b=document.body;
window.addEventListener('load',function(){setTimeout(function(){b.classList.add('ready')},300)});
setTimeout(function(){b.classList.add('ready')},2500);
var words=['Homes','Warehouses','Offices','Renovation','Facades','Roofing','Engineering'],h='';
for(var i=0;i<4;i++)words.forEach(function(w){h+='<span>'+w+'</span><span>/</span>'});
document.getElementById('mq').innerHTML=h;
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15});
document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});
var done=false;
function count(){if(done)return;done=true;document.querySelectorAll('[data-c]').forEach(function(el){var t=+el.dataset.c,s=null;function f(ts){s=s||ts;var p=Math.min((ts-s)/1800,1);el.textContent=Math.round(t*(1-Math.pow(1-p,4)));if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)})}
setTimeout(count,2300);
var hd=document.getElementById('hd'),pg=document.getElementById('pg'),gb=document.getElementById('gb'),st=document.getElementById('st');
function sc(){var y=window.scrollY,m=document.documentElement.scrollHeight-innerHeight;
pg.style.transform='scaleX('+(m>0?y/m:0)+')';hd.classList.toggle('solid',y>40);gb.style.transform='translateY('+(y*.15)+'px)';
var r=st.getBoundingClientRect();st.style.setProperty('--p',Math.max(0,Math.min(1,(innerHeight*.8-r.top)/(innerHeight*.5))))}
